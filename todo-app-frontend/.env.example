# Optional browser-facing API base URL (Create React App).
# Copy to .env.local; restart npm run dev after changes, or rebuild for production.
# An unset or blank value falls back to http://127.0.0.1:8080.
REACT_APP_API_BASE_URL=http://127.0.0.1:8080

# For the host React dev server using the Docker Compose backend:
# REACT_APP_API_BASE_URL=http://127.0.0.1:18080

# REACT_APP_* values are embedded in browser JavaScript. Never put secrets here.

# The Docker frontend builds with /api and uses its Nginx proxy.
# Local env files are excluded from the image; no setting is needed here for Docker.
