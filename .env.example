# Copy to .env at the repository root; never overwrite an existing configuration.
# Generate a password: python3 -c 'import secrets; print(secrets.token_hex(32))'
POSTGRES_PASSWORD=
POSTGRES_USER=todo
POSTGRES_DB=todo
FRONTEND_PORT=18000
BACKEND_PORT=18080
COMPOSE_PROJECT_NAME=todo-app
CORS_ALLOWED_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'

# Run from the repository root: docker compose up -d --build
# Stop while keeping PostgreSQL data: docker compose down
# Choose unused host ports if these defaults are occupied.
# Keep POSTGRES_* and COMPOSE_PROJECT_NAME stable when reusing persistent data.
